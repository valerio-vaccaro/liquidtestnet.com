<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="utf-8">
      <meta name="author" content="Valerio Vaccaro">
      <meta name="description" content="Get Liquid testnet L-BTC and test assets from the Liquid testnet faucet.">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <meta name="theme-color" content="#0c0d0f">
      <link rel="manifest" href="/site.webmanifest">
      <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
      <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png">
      <link rel="icon" type="image/png" sizes="48x48" href="/static/favicon-48x48.png">
      <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png">
      <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
      <link rel="shortcut icon" href="/static/favicon.ico">
      <title>Liquid faucet</title>
      <link href="/static/bootstrap.min.css" rel="stylesheet">
      <link href="/static/base.css" rel="stylesheet">
    <link href="/static/theme.css" rel="stylesheet">
      <script src="/static/jquery.min.js"></script>
      <script src="/static/bootstrap.min.js"></script>
   </head>
   <body>
    <nav class="site-nav">
      <div class="site-nav__inner">
        <a class="site-nav__brand" href="/">
          <span class="site-nav__logo" aria-hidden="true"></span>
          Liquid<span class="accent">testnet</span>
        </a>
        <button class="site-nav__toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <div class="site-nav__links">
          <a href="/">Home</a>
          <a href="/explorer">Explorer</a>
          <a href="/mempool">Mempool</a>
          <a href="/faucet">Faucet</a>
          <a href="/issuer">Issuer</a>
          <a href="/utils">Utils</a>
          <a href="https://liquidwebwallet.org/testnet/" target="_blank" rel="noopener">Liquid Web Wallet</a>
          <a href="/apidocs">API</a>
          <a href="/about">About</a>
        </div>
      </div>
    </nav>
      {{#faucet_success}}
      <div class="faucet-rain" id="faucetRain" aria-hidden="true"></div>
      {{/faucet_success}}
      <div class="container-fluid">
         <br/><br/><br/><br/>
         <div id="sl">
            <br/><br/>
            <div class="well">
               <h3>Faucet</h3>
               <p>Balance: {{balance}} sats.</p>
               {{^form}}
               <p>{{result}}</p>
               {{/form}}
               {{#form}}
               <form action="/faucet" method="get">
                   <div class="form-group row">
                      <label for="address" class="col-sm-2 col-form-label">Address</label>
                      <div class="col-sm-10">
                         <input type="text" class="form-control" name="address" required="required" id="address" placeholder="address">
                      </div>
                   </div>
                   <div class="form-group row">
                      <div class="col-sm-10">
                         <button type="submit" class="btn btn-danger" name="action" value="lbtc">Send assets</button>
                      </div>
                   </div>
                </form>
                {{/form}}

	       <h3>Faucet TEST asset</h3>
	       <p>TEST (asset id {{assetid}}) is a Liquid testnet asset registered in the Blockstream assset registry.</p> 
               <p>Balance: {{balance_test}} sats.</p>
               {{^form_test}}
               <p>{{result_test}}</p>
               {{/form_test}}
               {{#form_test}}
               <form action="/faucet" method="get">
                   <div class="form-group row">
                      <label for="address" class="col-sm-2 col-form-label">Address</label>
                      <div class="col-sm-10">
                         <input type="text" class="form-control" name="address" required="required" id="address" placeholder="address">
                      </div>
                   </div>
                   <div class="form-group row">
                      <div class="col-sm-10">
                         <button type="submit" class="btn btn-danger" name="action" value="test">Send assets</button>
                      </div>
                   </div>
                </form>
                {{/form_test}}
		<p>You can send back unused coins at the address <b>{{return_address}}</b>.</p>
            
	       <h3>Faucet AMP asset</h3>
	       <p>{{amp0_assetid}} is a Liquid testnet asset registered in the Blockstream AMP platform.</p>
	       <p>Balance: {{balance_amp}}</p>
	       {{^form_amp}}
               <p>{{result_amp}}</p>
               {{/form_amp}}
               {{#form_amp}}
               <form action="/faucet" method="get">
                   <div class="form-group row">
                      <label for="address" class="col-sm-2 col-form-label">AMP ID</label>
                      <div class="col-sm-10">
                         <input type="text" class="form-control" name="address" required="required" id="address" placeholder="AMP ID">
                      </div>
                   </div>
                   <div class="form-group row">
                      <div class="col-sm-10">
                         <button type="submit" class="btn btn-danger" name="action" value="amp">Send assets</button>
                      </div>
                   </div>
                </form>
                {{/form_amp}}
		<p>You can send back unused AMP assets at the address <b>{{amp0_return_address}}</b>.</p>
	    </div>
         </div>
      </div>
      </div>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Liquid testnet</span>
        <span class="site-footer__sep">&middot;</span>
        <span>v{{app_version}}</span>
        <span class="site-footer__sep">&middot;</span>
        <span>&copy; 2021-2026 Valerio Vaccaro</span>
        <span class="site-footer__sep">&middot;</span>
        <a href="https://github.com/valerio-vaccaro/liquidtestnet.com/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a>
      </div>
    </footer>
    <script src="/static/theme.js"></script>
    {{#faucet_success}}
    <script>
      (function () {
        var rain = document.getElementById("faucetRain");
        if (!rain || (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches)) return;

        var emoticons = ["✨", "🎉", "🥳", "💚", "😄", "🌟"];
        for (var i = 0; i < 32; i += 1) {
          var emoticon = document.createElement("span");
          emoticon.className = "faucet-rain__emoticon";
          emoticon.textContent = emoticons[i % emoticons.length];
          emoticon.style.setProperty("--x", Math.random() * 100 + "vw");
          emoticon.style.setProperty("--drift", (Math.random() * 160 - 80) + "px");
          emoticon.style.setProperty("--delay", Math.random() * 0.7 + "s");
          emoticon.style.setProperty("--duration", 2.6 + Math.random() * 1.4 + "s");
          rain.appendChild(emoticon);
        }

        window.setTimeout(function () { rain.remove(); }, 4500);
      }());
    </script>
    {{/faucet_success}}
   </body>
</html>
