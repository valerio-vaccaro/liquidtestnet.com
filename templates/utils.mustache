<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="utf-8">
      <meta name="author" content="Valerio Vaccaro">
      <link rel="icon" href="">
      <title>Liquid faucet</title>
      <link href="/static/bootstrap.min.css" rel="stylesheet">
      <link href="/static/base.css" rel="stylesheet">
    <link href="/static/theme.css" rel="stylesheet">
      <script src="/static/jquery.min.js"></script>
      <script src="/static/bootstrap.min.js"></script>
   </head>
   <body>
    <nav class="site-nav">
      <div class="site-nav__inner">
        <a class="site-nav__brand" href="/">
          <span class="site-nav__logo" aria-hidden="true"></span>
          Liquid<span class="accent">testnet</span>
        </a>
        <button class="site-nav__toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <div class="site-nav__links">
          <a href="/">Home</a>
          <a href="/explorer">Explorer</a>
          <a href="/mempool">Mempool</a>
          <a href="/faucet">Faucet</a>
          <a href="/issuer">Issuer</a>
          <a href="/utils">Utils</a>
          <a href="https://liquidwebwallet.org/testnet/" target="_blank" rel="noopener">Liquid Web Wallet</a>
          <a href="/about">About</a>
        </div>
      </div>
    </nav>
      <div class="container-fluid">
         <br/><br/><br/><br/>
         <div id="sl">
            <br/><br/>
            <div class="well">
               <h3>Write a phrase using OP_RETURN</h3>
               {{^form_opreturn}}
               <p>{{result_opreturn}}</p>
               {{/form_opreturn}}
               {{#form_opreturn}}
               <form action="/utils" method="get">
                   <input type="hidden" id="command" name="command" value="opreturn">
                   <div class="form-group row">
                      <label for="address" class="col-sm-2 col-form-label">Phrase in hex</label>
                      <div class="col-sm-10">
                         <input type="text" class="form-control" name="text" required="required" id="text" placeholder="deadbeef" pattern="([a-fA-F0-9]{2})+">
                      </div>
                   </div>
                   <div class="form-group row">
                      <div class="col-sm-10">
                         <button type="submit" class="btn btn-success" name="action" value="send" disabled>Write</button>
                      </div>
                   </div>
                </form>
                {{/form_opreturn}}
            </div>

            <div class="well">
               <h3>Test a transaction</h3>
               {{^form_test}}
               <p>{{result_test}}</p>
               {{/form_test}}
               {{#form_test}}
               <form action="/utils" method="get">
                   <input type="hidden" id="command" name="command" value="test">
                   <div class="form-group row">
                      <label for="tx" class="col-sm-2 col-form-label">Transaction in hex</label>
                      <div class="col-sm-10">
                         <textarea rows = "5" type="text" class="form-control" name="tx" required="required" id="tx" placeholder="tx"></textarea>
                      </div>
                   </div>
                   <div class="form-group row">
                      <div class="col-sm-10">
                         <button type="submit" class="btn btn-warning" name="action" value="broadcast">Test</button>
                      </div>
                   </div>
                </form>
                {{/form_test}}
              </div>

              <div class="well">
               <h3>Broadcast a transaction</h3>
               {{^form_broadcast}}
               <p>{{result_broadcast}}</p>
               {{/form_broadcast}}
               {{#form_broadcast}}
               <form action="/utils" method="get">
                   <input type="hidden" id="command" name="command" value="broadcast">
                   <div class="form-group row">
                      <label for="tx" class="col-sm-2 col-form-label">Transaction in hex</label>
                      <div class="col-sm-10">
                         <textarea rows = "5" type="text" class="form-control" name="tx" required="required" id="tx" placeholder="tx"></textarea>
                      </div>
                   </div>
                   <div class="form-group row">
                      <div class="col-sm-10">
                         <button type="submit" class="btn btn-danger" name="action" value="broadcast">Broadcast</button>
                      </div>
                   </div>
                </form>
                {{/form_broadcast}}

            </div>
         </div>
      </div>
      </div>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Liquid testnet</span>
        <span class="site-footer__sep">&middot;</span>
        <span>v{{app_version}}</span>
        <span class="site-footer__sep">&middot;</span>
        <span>&copy; 2021-2026 Valerio Vaccaro</span>
        <span class="site-footer__sep">&middot;</span>
        <a href="https://github.com/valerio-vaccaro/liquidtestnet.com/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a>
      </div>
    </footer>
    <script src="/static/theme.js"></script>
   </body>
</html>
